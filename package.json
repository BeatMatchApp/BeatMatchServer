{
  "name": "beatmatchserver",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.ts",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "start": "tsc && node ./dist/src/server.js",
    "prod": "rm -r -f ./public/client && tsc -p tsconfig_prod.json && cp -a ../BeatMatchClient/dist ./public/client && cp -a ../BeatMatchClient/public/assets ./public/assets && pm2 restart ecosystem.config.js --env production",
    "migrate": "knex migrate:latest --knexfile src/config/db.ts --env development",
    "migrate:prod": "npx ts-node -r dotenv/config ./node_modules/.bin/knex migrate:latest --knexfile src/config/db.ts --env production",
    "rollback": "knex migrate:rollback --knexfile src/config/db.ts --env development"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeatMatchApp/BeatMatchServer.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/BeatMatchApp/BeatMatchServer/issues"
  },
  "homepage": "https://github.com/BeatMatchApp/BeatMatchServer#readme",
  "dependencies": {
    "@google-cloud/aiplatform": "^3.0.0",
    "@google/generative-ai": "^0.24.0",
    "axios": "^1.9.0",
    "bcrypt": "^5.1.1",
    "body-parser": "^2.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^4.21.2",
    "google-auth-library": "^9.15.1",
    "http-proxy-middleware": "^3.0.5",
    "https": "^1.0.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "openai": "^4.97.0",
    "pg": "^8.14.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.13",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^16.18.126",
    "@types/pg": "^8.11.13",
    "nodemon": "^2.0.15",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
  }
}
